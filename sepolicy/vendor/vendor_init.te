get_prop(vendor_init, vendor_radio_prop);

allow vendor_init cgroup:file getattr;
allow vendor_init tmpfs:dir { write add_name };
allow vendor_init tmpfs:lnk_file create;
allow vendor_init functionfs:file getattr;

allow vendor_init proc_swappiness:file rw_file_perms;

allow vendor_init cpdebug_efs_file:lnk_file { getattr setattr };
allow vendor_init pdp_efs_file:file getattr;

allow vendor_init proc_sched:file rw_file_perms;

allow vendor_init sysfs_nfc_power_writable:file rw_file_perms;

dontaudit vendor_init radio_prop:file read;
dontaudit vendor_init system_prop:file read;

typeattribute vendor_init data_between_core_and_vendor_violators;
allow vendor_init system_data_file:dir search;
allow vendor_init nfc_data_file:dir create_dir_perms;
allow vendor_init nfc_data_file:file create_file_perms;

allow vendor_init system_file:file r_file_perms;

dontaudit vendor_init default_prop:property_service set;
dontaudit vendor_init logpersistd_logging_prop:property_service set;
dontaudit vendor_init system_prop:property_service set;
dontaudit vendor_init vold_prop:property_service set;
dontaudit vendor_init debugfs:file setattr;
dontaudit vendor_init debugfs_trace_marker:file getattr;
dontaudit vendor_init { default_prop vts_status_prop }:file r_file_perms;
