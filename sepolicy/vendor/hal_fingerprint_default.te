# Fingerprint
r_dir_file(hal_fingerprint_default, efs_file)
r_dir_file(hal_fingerprint_default, app_efs_file)

allow hal_fingerprint_default sec_efs_file:dir r_dir_perms;
allow hal_fingerprint_default sec_efs_file:file r_file_perms;

allow hal_fingerprint_default sysfs_battery:dir search;
allow hal_fingerprint_default sysfs_battery:file { open read };

allow hal_fingerprint_default sysfs_lcd_writable:dir r_dir_perms;
allow hal_fingerprint_default sysfs_lcd_writable:file rw_file_perms;
allow hal_fingerprint_default sysfs_backlight_writable:file rw_file_perms;

allow hal_fingerprint_default sysfs_sec_touchscreen:dir r_dir_perms;
allow hal_fingerprint_default sysfs_touchscreen_writable:file rw_file_perms;

allow hal_fingerprint_default goodix_device:chr_file rw_file_perms;
