<!--
    The stock a54x manifest declares vendor.samsung.hardware.gnss at AIDL
    version 3, but the shared hardware/samsung/vintf matrix only lists it at
    version 2. Add a device-specific framework matrix entry for version 3 so
    checkvintf accepts the manifest.
-->
<compatibility-matrix version="2.0" type="framework">
    <hal format="aidl">
        <name>vendor.samsung.hardware.gnss</name>
        <version>3</version>
        <interface>
            <name>ISehGnss</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
